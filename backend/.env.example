# Server
PORT=4000

# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LocationIQ geocoding (free tier: https://locationiq.com)
LOCATIONIQ_API_KEY=your-locationiq-key

# Python/FastAPI VRP solver service
SOLVER_URL=http://localhost:8000

# Single-tenant thin slice: id of the seed row in db/schema.sql
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
